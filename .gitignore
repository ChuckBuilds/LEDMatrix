__pycache__/
*.py[cod]
*$py.class

# Secrets
config/config_secrets.json
config/config.json
config/config.json.backup
config/wifi_config.json
config/uninstalled_plugins.json
credentials.json
token.pickle

# Environment
.env
.venv
env/
venv/
venv*/
ENV/

